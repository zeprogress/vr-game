{
  "name": "vr-game",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*.ts"
  },
  "scripts": {
    "dev": "vite",
    "dev:vr": "VR=1 vite",
    "server": "tsx watch src/server/index.ts",
    "dev:all": "tsx watch src/server/index.ts & VR=1 vite",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "tunnel:443": "ssh -n -p 443 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ServerAliveInterval=30 -R0:localhost:5173 a.pinggy.io"
  },
  "dependencies": {
    "@babylonjs/core": "^7.34.0",
    "@babylonjs/materials": "^7.54.3",
    "@colyseus/schema": "^2.0.37",
    "colyseus": "^0.15.6",
    "colyseus.js": "^0.15.28"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
