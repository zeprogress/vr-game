# Секреты стрима (этап 17). Скопировать в deploy/stream.env на VPS, chmod 600.
# Файл в .gitignore — в репозиторий не попадает.
#
#   cp deploy/stream.env.example deploy/stream.env
#   nano deploy/stream.env          # вписать реальные значения
#   chmod 600 deploy/stream.env
#   sudo cp deploy/vrgame.service /etc/systemd/system/vrgame.service   # (подставив __APPDIR__=/opt/vrgame)
#   sudo systemctl daemon-reload && sudo systemctl restart vrgame

# Ключ невидимого спектатора. Длинная случайная строка.
# Открывается страницей: https://zepgame.duckdns.org/?spectator=ЭТОТ_КЛЮЧ
SPECTATOR_KEY=

# --- Twitch (этап 17 Ф10) ---
# Чат канала читается всегда и без токена (анонимный логин justinfan…):
# команды !play / !stop / !skin работают сразу. Токен нужен ТОЛЬКО чтобы
# сервер мог ОТВЕЧАТЬ в чат (!info, подтверждения) — анонимам Twitch писать
# не даёт.
#
# Где взять:
#   1. Завести отдельный аккаунт для бота (или использовать свой) и залогиниться им.
#   2. https://twitchtokengenerator.com → Bot Chat Token → права chat:read + chat:edit.
#   3. Сюда — логин аккаунта и полученный ACCESS TOKEN (префикс `oauth:` можно не писать).
# Токен протухает (обычно ~60 дней): в логах появится
#   "[twitch] токен не принят — дальше только чтение" — значит пора обновить.
# Пусто — всё работает как раньше, просто без ответов в чат.
TWITCH_BOT_USER=
TWITCH_OAUTH=

# Канал, чей чат слушаем. Не задан — берётся TWITCH_CHANNEL из shared/constants.
TWITCH_CHANNEL=

# Дальше — для следующих фаз (дашборд, алерты). Пока можно не заполнять.
DASHBOARD_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
